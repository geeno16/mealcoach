{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Сбросить БД",
      "type": "shell",
      "command": "python -m src.common.dropdb_vstask",
      "options": { "cwd": "/workspace/backend" },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Backend: Запустить dev сервер",
      "type": "shell",
      "command": "python -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "/workspace/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "servers"
      }
    },
    {
      "label": "Frontend: Запустить dev сервер",
      "type": "shell",
      "command": "curl -sf http://localhost:8000/openapi.json > /dev/null 2>&1 || { echo 'Бэк не запущен на http://localhost:8000 — сначала запустите задачу «Backend: запустить dev сервер»'; exit 1; }; npm run gen:api && npm run dev",
      "options": { "cwd": "/workspace/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "servers"
      }
    },
    {
      "label": "Статика: Собрать и раздать",
      "type": "shell",
      "command": "python -m uvicorn src.main:app --host 0.0.0.0 --port 8000 & UVICORN_PID=$! && until curl -sf http://localhost:8000/openapi.json > /dev/null; do sleep 1; done && (cd /workspace/frontend && npm run gen:api && npm run build) && kill $UVICORN_PID && python -m uvicorn src.main:app --host 0.0.0.0 --port 8000",
      "options": { "cwd": "/workspace/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "servers"
      }
    },
    {
      "label": "Backend: Запустить тесты",
      "type": "shell",
      "command": "pytest",
      "options": { "cwd": "/workspace/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Backend: Пройти регистрацию",
      "type": "shell",
      "command": "python -m src.common.auth_flow_vstask",
      "options": { "cwd": "/workspace/backend" },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true
      }
    }
  ]
}
