{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "БД: Сбросить",
      "type": "shell",
      "command": "python -m src.common.dropdb_vstask",
      "options": { "cwd": "/workspace/backend" },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Backend: Запустить",
      "type": "shell",
      "command": "python -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "/workspace/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "servers"
      }
    },
  ]
}
