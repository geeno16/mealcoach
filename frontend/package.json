{
  "name": "mealcoach-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config settings/vite.config.ts",
    "build": "tsc --noEmit && vite build --config settings/vite.config.ts",
    "preview": "vite preview --config settings/vite.config.ts",
    "lint": "eslint . --config settings/eslint.config.cjs",
    "format": "prettier --write . --config settings/prettier.config.cjs"
  },
  "dependencies": {
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import-x": "^4.15.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "prettier-plugin-css-order": "^2.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5"
  }
}
